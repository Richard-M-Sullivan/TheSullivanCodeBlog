# Copy to /etc/sullivancodeblog/blog.env on the server and fill in.
# Do NOT commit the filled-in copy.
#
# Format is systemd EnvironmentFile, not shell: KEY=value, no `export`,
# no command substitution, no variable references in values.

# Absolute path to the repo checkout on the server.
APP_DIR=/srv/TheSullivanCodeBlog

# Absolute path to the node binary (`which node`).
# nvm users: /home/<user>/.nvm/versions/node/v22.x.x/bin/node
NODE_BIN=/usr/bin/node

NODE_ENV=production
PORT=

